# Server-only Firebase config. Do not prefix these with NEXT_PUBLIC_.
# Web app values come from the Firebase console snippet.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Service account, required before Pay my bill can read Firestore.
# Keep the private key on one line, with newlines written as \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The id of the Firestore database, exactly as the Firebase console shows it.
# "(default)" and "default" are different databases.
FIRESTORE_DATABASE_ID=default

# Staff area at /staff. Each person signs in with their own email and password,
# stored in Firestore. STAFF_PASSCODE is the setup key: /staff/setup asks for it
# once, to create the first admin. Server-only. Use a long random value.
STAFF_PASSCODE=

# Stripe Checkout. Server-only. Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
DOMAIN=http://localhost:3000

# Signing secret for /api/stripe/webhook (starts with whsec_). Locally it comes from
# `stripe listen`. In production it comes from the endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
